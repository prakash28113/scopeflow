{
  "name": "scopeflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && npm run predeploy:check && wrangler deploy",
    "audit:secrets": "node scripts/secret-scan.mjs",
    "predeploy:check": "node scripts/predeploy-check.mjs",
    "audit:deps": "node scripts/deps-audit.mjs",
    "audit:spelling": "node scripts/spelling-check.mjs",
    "verify": "npm run typecheck && npm test && npm run audit:secrets && npm run audit:deps",
    "test:tz": "TZ=Pacific/Honolulu vitest run tests/unit && TZ=Pacific/Kiritimati vitest run tests/unit && TZ=Asia/Kolkata vitest run tests/unit"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "html-to-image": "1.11.13",
    "jspdf": "4.2.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
