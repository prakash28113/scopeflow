{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scopeflow",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Keep the free *.workers.dev address live even after a custom domain is added,
  // so links already shared with clients keep working.
  "workers_dev": true,
  // Pages and files are served straight from static assets (free, unlimited,
  // no Worker CPU). Unknown page paths get index.html for client-side routing.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker sees every request except built assets: https/www redirects, real 404s for unknown
    // pages, and blog pages rendered with the posts (worker/blog.ts). Everything else goes straight
    // back to static assets.
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // Twice-daily keep-alive so the free Supabase project isn't paused for inactivity.
  "triggers": { "crons": ["17 3,15 * * *"] },
  // Public values only (the anon key is designed to be public). No secrets here.
  "vars": {
    "SUPABASE_URL": "https://YOUR-PROJECT-REF.supabase.co",
    "SUPABASE_ANON_KEY": "YOUR-PUBLISHABLE-KEY"
  },
  "observability": { "enabled": true }
}
