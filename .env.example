# ---------------------------------------------------------------- Supabase
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses RLS; used only for notification lookups and the email log.
# Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------- App
# Public base URL, no trailing slash. Used in client links and auth emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts stored client links so you can re-copy them.
# Generate with:  openssl rand -base64 32
# If you change it, existing links keep working but can't be re-displayed —
# use "New link" on a project to issue a fresh one.
SHARE_TOKEN_SECRET=

# ---------------------------------------------------------------- Email (optional)
# Without RESEND_API_KEY, emails are not sent and are logged as "skipped";
# the app shows the client link so you can share it yourself.
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend.
# (onboarding@resend.dev only delivers to your own Resend account email.)
EMAIL_FROM=ScopeFlow <notifications@yourdomain.com>
