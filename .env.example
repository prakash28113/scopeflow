# Copy to .env.local for development, and set the same values when building for deploy.
# Both values are public by design: security comes from RLS and database functions.

# Supabase → Project Settings → API Keys
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…). The legacy anon key also works via VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional: Cloudflare Turnstile (free CAPTCHA) for sign-up and sign-in.
# Also enable CAPTCHA in Supabase → Authentication → Attack Protection / Bot and Abuse Protection
# with the matching secret key. Leave empty to disable.
VITE_TURNSTILE_SITE_KEY=
