# Copy to .env.local for development (and set the same values when building for deploy).
# Both values are public by design: security comes from RLS and database functions.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Cloudflare Turnstile (free CAPTCHA) for sign-up and sign-in.
# Also enable CAPTCHA in Supabase → Authentication → Bot and Abuse Protection
# with the matching secret key. Leave empty to disable.
VITE_TURNSTILE_SITE_KEY=
